{
    "name": "@zyno-io/pixelci-ui",
    "version": "0.3.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "rimraf node_modules/.vite && vite",
        "build": "run-p typecheck build-only",
        "preview": "vite preview",
        "test:unit": "vitest",
        "test:e2e": "playwright test",
        "test:types": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
        "build-only": "vite build",
        "typecheck": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
        "format": "npx oxlint --fix --fix-suggestions --fix-dangerously && oxfmt"
    },
    "dependencies": {
        "@fontsource/inter": "^5.3.0",
        "@fortawesome/fontawesome-free": "^7.3.1",
        "@sentry/browser": "^10.69.0",
        "@sentry/vue": "^10.69.0",
        "@zyno-io/openapi-client-codegen": "^2.10.0",
        "@zyno-io/vue-foundation": "^4.34.0",
        "date-fns": "^4.4.0",
        "lodash": "^4.18.1",
        "openapi-typescript-codegen": "^0.31.0",
        "pinia": "^4.0.2",
        "postinstall-postinstall": "^2.1.0",
        "uuid": "^14.0.1",
        "vue": "^3.5.40",
        "vue-router": "^5.2.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.62.1",
        "@tailwindcss/postcss": "^4.3.3",
        "@tsconfig/node22": "^22.0.5",
        "@types/jsdom": "^28.0.3",
        "@types/lodash": "^4.17.25",
        "@types/node": "^26.1.2",
        "@types/uuid": "^11.0.0",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vue/test-utils": "^2.4.11",
        "@vue/tsconfig": "^0.9.1",
        "jsdom": "^30.0.1",
        "npm-run-all": "^4.1.5",
        "postcss": "^8.5.25",
        "rimraf": "^6.1.3",
        "sass": "^1.102.0",
        "tailwindcss": "~4",
        "type-fest": "^5.8.0",
        "typescript": "npm:typescript-native-bridge@6.0.3-bridge.9.tsgo.7.0.2",
        "vite": "^8.2.0",
        "vite-plugin-oxlint": "^2.1.2",
        "vitest": "^4.1.10",
        "vue-tsc": "^3.3.9"
    }
}
