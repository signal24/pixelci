{
    "name": "@zyno-io/pixelci-ui",
    "version": "0.3.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "rimraf node_modules/.vite && vite",
        "build": "run-p typecheck build-only",
        "preview": "vite preview",
        "test:unit": "vitest",
        "test:e2e": "playwright test",
        "test:types": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
        "build-only": "vite build",
        "typecheck": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
        "format": "npx oxlint --fix --fix-suggestions --fix-dangerously && oxfmt"
    },
    "dependencies": {
        "@fontsource/inter": "^5.2.8",
        "@fortawesome/fontawesome-free": "^7.2.0",
        "@sentry/browser": "^10.57.0",
        "@sentry/vue": "^10.57.0",
        "@zyno-io/openapi-client-codegen": "^2.8.0",
        "@zyno-io/vue-foundation": "^4.33.7",
        "date-fns": "^4.4.0",
        "lodash": "^4.18.1",
        "openapi-typescript-codegen": "^0.30.0",
        "pinia": "^3.0.4",
        "postinstall-postinstall": "^2.1.0",
        "uuid": "^14.0.0",
        "vue": "^3.5.38",
        "vue-router": "^5.1.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.60.0",
        "@tailwindcss/postcss": "^4.3.1",
        "@tsconfig/node22": "^22.0.5",
        "@types/jsdom": "^28.0.3",
        "@types/lodash": "^4.17.24",
        "@types/node": "^25.9.3",
        "@types/uuid": "^11.0.0",
        "@vitejs/plugin-vue": "^6.0.7",
        "@vue/test-utils": "^2.4.11",
        "@vue/tsconfig": "^0.9.1",
        "jsdom": "^29.1.1",
        "npm-run-all": "^4.1.5",
        "postcss": "^8.5.15",
        "rimraf": "^6.1.3",
        "sass": "^1.101.0",
        "tailwindcss": "~4",
        "type-fest": "^5.7.0",
        "typescript": "~6.0.3",
        "vite": "^8.0.16",
        "vite-plugin-oxlint": "^2.1.2",
        "vitest": "^4.1.8",
        "vue-tsc": "^3.3.5"
    }
}
