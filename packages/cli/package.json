{
    "name": "@zyno-io/pixelci-cli",
    "version": "0.3.0",
    "private": true,
    "description": "",
    "keywords": [],
    "license": "UNLICENSED",
    "author": "",
    "type": "module",
    "main": "./dist/index.js",
    "scripts": {
        "clean": "rm -rf dist",
        "dev": "APP_ENV=${APP_ENV:-development} npm-run-all clean -p dev:ttsc dev:run",
        "dev:run": "sh -c 'while ! [ -f dist/index.js ]; do sleep 1; done; dotenv yarn start:debug ../api/tests/integration/fixtures'",
        "start": "node dist/index.js",
        "start:debug": "node --inspect=9210 --watch dist/index.js",
        "test": "ttsc && node --experimental-test-module-mocks --test dist/*.spec.js",
        "format": "npx oxlint --fix --fix-suggestions --fix-dangerously && oxfmt",
        "dev:ttsc": "ttsc -w --preserveWatchOutput -p tsconfig.json"
    },
    "dependencies": {
        "@zyno-io/ts-reflection": "^26.803.2224"
    },
    "devDependencies": {
        "@faker-js/faker": "^10.5.0",
        "@types/node": "^26.1.2",
        "dotenv-cli": "^11.0.0",
        "npm-run-all": "^4.1.5",
        "ttsc": "0.23.0",
        "typescript": "~7.0.2"
    }
}
